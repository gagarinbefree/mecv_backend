{
  "name": "mecv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Functional NestJS foundation for a GraphQL professional profile",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "codegen": "npm run codegen:graphql && npm run codegen:prisma",
    "codegen:graphql": "graphql-codegen --config codegen.ts",
    "codegen:prisma": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "predb:seed": "npm run build",
    "db:seed": "prisma db seed",
    "prelint": "npm run codegen",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run codegen",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run codegen",
    "test": "node scripts/run-tests.ts",
    "test:docker": "node scripts/test-docker.ts",
    "pretest:watch": "npm run codegen",
    "test:watch": "vitest",
    "prebuild": "npm run codegen",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-assets.mjs",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apollo/gateway": "2.14.4",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
